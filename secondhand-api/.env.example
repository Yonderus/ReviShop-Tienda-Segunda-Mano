NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/secondhand-db
# Orígenes del front, separados por comas, para la comprobación de Origin contra CSRF (CORS lo pone el gateway).
# En desarrollo, si falta, se usa http://localhost:4200; en producción es obligatoria.
CORS_ORIGIN=http://localhost:4200
# Contraseña que el seed asigna a todos los usuarios de prueba (mínimo 8 caracteres)
SEED_DEFAULT_PASSWORD=
# Firma de los JWT (mínimo 32 caracteres, aleatoria y fuera del repositorio). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Duración del access token: 15m, 1h… (por defecto 15m). Corto a propósito: el front lo renueva solo con el refresh.
JWT_ACCESS_EXPIRES_IN=15m
# Refresh token: días que vale cada uno, tope de días de una sesión desde el login y segundos de margen para que
# dos pestañas refresquen a la vez sin que cuente como robo.
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_SESSION_MAX_DAYS=30
REFRESH_REUSE_GRACE_SECONDS=30