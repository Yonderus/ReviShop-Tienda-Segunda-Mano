NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/secondhand-db
# Orígenes del front, separados por comas (CORS con cookies y comprobación de Origin).
# En desarrollo, si falta, se usa http://localhost:4200; en producción es obligatoria.
CORS_ORIGIN=http://localhost:4200
# Contraseña que el seed asigna a todos los usuarios de prueba (mínimo 8 caracteres)
SEED_DEFAULT_PASSWORD=
# Firma de los JWT (mínimo 32 caracteres, aleatoria y fuera del repositorio). Genera una con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Caducidad de los tokens: 15m, 1h, 7d… (por defecto 1d)
JWT_EXPIRES_IN=1d