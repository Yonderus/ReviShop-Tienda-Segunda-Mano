NODE_ENV=development
PORT=3001
# La API de la tienda. La IA NO tiene acceso a la base de datos: todo lo pide aquí (sesión y datos públicos).
CORE_API_URL=http://localhost:3000/api
# Orígenes del front, separados por comas, para la comprobación de Origin (CORS lo pone el gateway).
# En desarrollo, si falta, se usa http://localhost:4200; en producción es obligatoria.
CORS_ORIGIN=http://localhost:4200

# Proveedor del modelo: groq (por defecto, con plan gratuito), openrouter, xai (Grok directo) o fake (respuestas
# de prueba, sin gastar ni internet)
AI_PROVIDER=groq
# Solo hace falta la del proveedor elegido. Sin ella el servicio arranca, pero el asistente responde 503.
# Groq: crea la key en https://console.groq.com/keys
GROQ_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
# Modelo del proveedor. Tiene que admitir tools (tool calling). En Groq, p. ej. llama-3.3-70b-versatile
# (la lista está en https://console.groq.com/docs/tool-use).
AI_MODEL=
# Opcional: otra URL compatible con la API de OpenAI. Sin ella, la del proveedor elegido.
# AI_BASE_URL=

# Límites
AI_MAX_TOKENS=600
AI_TIMEOUT_MS=25000
AI_MAX_TOOL_STEPS=4
# Mensajes al asistente por usuario y hora
AI_RATE_LIMIT_PER_HOUR=30
