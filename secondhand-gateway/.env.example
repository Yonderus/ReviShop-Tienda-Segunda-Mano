NODE_ENV=development
# El único puerto que conoce el navegador
PORT=4000
# Adónde reparte (sin /api: la ruta se reenvía tal cual)
API_URL=http://localhost:3000
AI_URL=http://localhost:3001
# Orígenes del front, separados por comas. CORS vive solo aquí. En desarrollo, si falta, http://localhost:4200;
# en producción es obligatoria.
CORS_ORIGIN=http://localhost:4200
# Cuánto se espera a cada servicio antes de responder 504
API_PROXY_TIMEOUT_MS=30000
AI_PROXY_TIMEOUT_MS=45000
